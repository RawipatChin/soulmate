rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'] &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function isSuperAdmin() {
      return isAdmin() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    function isActiveCustomer() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'customer' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function isGuest() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function customerCreatesOwnProfile(userId) {
      return isOwner(userId) &&
        request.resource.data.keys().hasOnly([
          'email', 'displayName', 'firstName', 'lastName', 'phone', 'photoURL',
          'role', 'status', 'membershipTier', 'completedOrderCount',
          'lifetimeSpend', 'defaultShippingAddress', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.role == 'customer' &&
        request.resource.data.status == 'active' &&
        (!('membershipTier' in request.resource.data) ||
          request.resource.data.membershipTier == 'classic') &&
        request.resource.data.completedOrderCount == 0 &&
        request.resource.data.lifetimeSpend == 0;
    }

    function customerUpdatesOwnProfile(userId) {
      return isOwner(userId) && resource.data.status == 'active' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'firstName', 'lastName', 'phone', 'photoURL',
          'defaultShippingAddress', 'updatedAt'
        ]);
    }

    // Users collection: profiles for customers and administrators
    match /users/{userId} {
      allow get: if (isOwner(userId) && resource.data.status == 'active') || isAdmin();
      allow list: if isAdmin();
      // A customer may edit their profile, but cannot grant themselves admin access.
      allow create: if isSuperAdmin() || customerCreatesOwnProfile(userId);
      allow update: if isSuperAdmin() ||
        (isAdmin() && request.resource.data.role == resource.data.role && request.resource.data.status == resource.data.status) ||
        customerUpdatesOwnProfile(userId);
      allow delete: if isSuperAdmin();

      // Cart subcollection
      match /cart/{cartItemId} {
        allow read, write: if (isOwner(userId) && get(/databases/$(database)/documents/users/$(userId)).data.status == 'active') || isAdmin();
      }
    }

    // Products collection: e-commerce products
    match /products/{productId} {
      // Visitors can read published products. Admins can also read drafts.
      // Public list queries must include where('status', '==', 'active').
      allow read: if resource.data.status == 'active' || isAdmin();
      // Products can be created, edited, and deleted by administrators
      allow write: if isAdmin();
    }

    // Admins collection: managed administrative accounts
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    // Cloud Functions are the only writers. Email and order number never grant access.
    match /orders/{orderId} {
      allow get, list: if isAdmin() || (
        isSignedIn() && resource.data.ownerUid == request.auth.uid &&
        (isGuest() || isActiveCustomer())
      );
      allow create, update, delete: if false;
    }

    // Default fallback: deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
