rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'] &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function isSuperAdmin() {
      return isAdmin() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    function superAdminChangesRole() {
      return isSuperAdmin() &&
        resource.data.status == 'active' &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.role in ['customer', 'admin', 'super_admin'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt']) &&
        request.resource.data.updatedAt == request.time;
    }

    function validOperationalPaymentMethod(method) {
      return method is map &&
        method.keys().hasOnly(['id', 'enabled']) &&
        method.keys().hasAll(['id', 'enabled']) &&
        method.id in ['promptpay', 'cod'] &&
        method.enabled is bool;
    }

    function validOperationalPaymentMethods(methods) {
      return methods is list && methods.size() <= 2 &&
          (methods.size() == 0 || validOperationalPaymentMethod(methods[0])) &&
          (methods.size() < 2 || validOperationalPaymentMethod(methods[1])) &&
          (methods.size() < 2 || methods[0].id != methods[1].id);
    }

    function adminCreatesOperationalSettings() {
      return isAdmin() &&
        request.resource.data.keys().hasOnly(['shippingMethods', 'announcements', 'paymentMethods', 'updatedAt', 'updatedBy']) &&
        validOperationalPaymentMethods(request.resource.data.get('paymentMethods', [])) &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.updatedAt == request.time;
    }

    function adminUpdatesOperationalSettings() {
      return isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'shippingMethods', 'announcements', 'paymentMethods', 'updatedAt', 'updatedBy'
        ]) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentMethods']) ||
          validOperationalPaymentMethods(request.resource.data.get('paymentMethods', []))) &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.updatedAt == request.time;
    }

    function adminChangesPaymentAvailability() {
      return isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enabled', 'updatedAt', 'updatedBy']) &&
        request.resource.data.phone == resource.data.phone &&
        request.resource.data.payeeName == resource.data.payeeName &&
        request.resource.data.enabled is bool &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.updatedAt == request.time;
    }

    function formatOrderNumber(year, sequence) {
      let value = string(sequence);
      let padded = sequence < 10 ? '000' + value :
        sequence < 100 ? '00' + value :
        sequence < 1000 ? '0' + value : value;
      return 'SM-' + string(year) + padded;
    }

    function advancesOrderSequence() {
      let data = request.resource.data;
      let orderPath = /databases/$(database)/documents/orders/$(data.orderSequenceOrderId);
      let order = getAfter(orderPath).data;
      let orderYear = (request.time + duration.value(7, 'h')).year();
      let previousYear = resource.data.get('orderSequenceYear', 0);
      return isSignedIn() &&
        data.diff(resource.data).affectedKeys().hasOnly([
          'orderSequenceYear', 'orderSequence', 'orderSequenceText', 'orderSequenceOrderId'
        ]) &&
        data.orderSequenceYear == orderYear &&
        data.orderSequence is int && data.orderSequence > 0 &&
        data.orderSequenceText is string && data.orderSequenceText == formatOrderNumber(orderYear, data.orderSequence) &&
        data.orderSequenceOrderId is string && data.orderSequenceOrderId.size() > 0 &&
        (previousYear == orderYear
          ? resource.data.orderSequence is int && data.orderSequence == resource.data.orderSequence + 1
          : data.orderSequence == 1) &&
        !exists(orderPath) && order.ownerUid == request.auth.uid &&
        order.orderNumber == data.orderSequenceText;
    }

    function isActiveCustomer() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['customer', 'user'] &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function isGuest() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function customerCreatesOwnProfile(userId) {
      return isOwner(userId) &&
        request.resource.data.keys().hasOnly([
          'email', 'displayName', 'firstName', 'lastName', 'phone', 'photoURL',
          'role', 'status', 'membershipTier', 'completedOrderCount',
          'lifetimeSpend', 'defaultShippingAddress', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.role == 'customer' &&
        request.resource.data.status == 'active' &&
        (!('membershipTier' in request.resource.data) ||
          request.resource.data.membershipTier == 'classic') &&
        request.resource.data.completedOrderCount == 0 &&
        request.resource.data.lifetimeSpend == 0;
    }

    function customerUpdatesOwnProfile(userId) {
      return isOwner(userId) && resource.data.status == 'active' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'firstName', 'lastName', 'phone', 'photoURL',
          'defaultShippingAddress', 'updatedAt'
        ]);
    }

    // Users collection: profiles for customers and administrators
    match /users/{userId} {
      allow get: if (isOwner(userId) && resource.data.status == 'active') || isAdmin();
      allow list: if isAdmin();
      // A customer may edit their profile, but cannot grant themselves admin access.
      allow create: if customerCreatesOwnProfile(userId);
      allow update: if (superAdminChangesRole()) ||
        (isSuperAdmin() && request.resource.data.role == resource.data.role) ||
        (isAdmin() && request.resource.data.role == resource.data.role && request.resource.data.status == resource.data.status) ||
        customerUpdatesOwnProfile(userId);
      allow delete: if isSuperAdmin();

      // Cart subcollection
      match /cart/{cartItemId} {
        allow read, write: if (isOwner(userId) && get(/databases/$(database)/documents/users/$(userId)).data.status == 'active') || isAdmin();
      }
    }

    // Products collection: e-commerce products
    match /products/{productId} {
      // Visitors can read published products. Admins can also read drafts.
      // Public list queries must include where('status', '==', 'active').
      allow read: if resource.data.status == 'active' || isAdmin();
      // Products can be created, edited, and deleted by administrators
      allow write: if isAdmin();
    }

    // Public storefront reads only banners explicitly enabled by an admin.
    // Public list queries must include where('active', '==', true).
    match /banners/{bannerId} {
      allow get, list: if resource.data.active == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Admins collection: managed administrative accounts
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    function optionPath(line) {
      return /databases/$(database)/documents/inventory/$(line.productId)/options/$(line.optionId);
    }

    function validLineData(orderId, items, index) {
      let line = index < items.size() ? items[index] : {};
      let option = index < items.size() ? getAfter(optionPath(line)).data : {};
      return index >= items.size() || (
        line.quantity is int &&
        line.quantity >= 1 && line.quantity <= 99 &&
        line.productId is string &&
        line.optionId is string &&
        line.optionId == (line.variantId == null ? 'base' : 'v_' + line.variantId) &&
        option.productId == line.productId &&
        option.variantId == line.variantId &&
        option.lastOrderId == orderId &&
        option.lastOrderLine == index &&
        option.unitPriceSatang == line.unitPriceSatang &&
        line.lineTotalSatang == line.unitPriceSatang * line.quantity
      );
    }

    function lineTotal(items, index) {
      return index < items.size() ? items[index].lineTotalSatang : 0;
    }

    function paymentEnabledAt(methods, methodId, index) {
      return index < methods.size() && methods[index].get('id', '') == methodId && methods[index].get('enabled', false) == true;
    }

    function paymentEnabled(methods, methodId) {
      return methods is list && (
        paymentEnabledAt(methods, methodId, 0) || paymentEnabledAt(methods, methodId, 1) ||
        paymentEnabledAt(methods, methodId, 2) || paymentEnabledAt(methods, methodId, 3) ||
        paymentEnabledAt(methods, methodId, 4) || paymentEnabledAt(methods, methodId, 5) ||
        paymentEnabledAt(methods, methodId, 6) || paymentEnabledAt(methods, methodId, 7) ||
        paymentEnabledAt(methods, methodId, 8) || paymentEnabledAt(methods, methodId, 9)
      );
    }

    function validPayment(data, methods) {
      return data.payment.method == 'cod'
        ? paymentEnabled(methods, 'cod') && data.payment.promptPayPhone == null
        : data.payment.method == 'manual_promptpay' &&
          (paymentEnabled(methods, 'promptpay') || (methods is list && methods.size() == 0)) &&
          get(/databases/$(database)/documents/config/payment).data.enabled == true &&
          data.payment.promptPayPhone == get(/databases/$(database)/documents/config/payment).data.phone;
    }

    function shippingMatchesAt(data, methods, index) {
      let method = index < methods.size() ? methods[index] : {};
      // Check the selected method before calculating its fee. Eager calculations
      // for every candidate can exhaust Firestore's 1,000-expression budget.
      return index < methods.size() && method.get('id', '') == data.shippingMethodId &&
        method.get('enabled', false) == true && data.shippingFeeSatang == (
          method.get('freeShippingThreshold', null) != null && data.subtotalSatang >= method.get('freeShippingThreshold', null) * 100
            ? 0 : method.get('fee', -1) * 100);
    }

    function validShipping(data, methods) {
      return methods is list && methods.size() > 0
        ? shippingMatchesAt(data, methods, 0) || shippingMatchesAt(data, methods, 1) || shippingMatchesAt(data, methods, 2) || shippingMatchesAt(data, methods, 3) || shippingMatchesAt(data, methods, 4) || shippingMatchesAt(data, methods, 5) || shippingMatchesAt(data, methods, 6) || shippingMatchesAt(data, methods, 7) || shippingMatchesAt(data, methods, 8) || shippingMatchesAt(data, methods, 9)
        : data.shippingMethodId == 'standard' && data.shippingFeeSatang == 3000;
    }

    function canCreateOrder(orderId) {
      let data = request.resource.data;
      let items = data.items;
      let settings = get(/databases/$(database)/documents/settings/public).data;
      let sequence = getAfter(/databases/$(database)/documents/settings/public).data;
      let isSequentialNumber = data.orderNumber is string && data.orderNumber.matches('^SM-[0-9]{8,}$');
      return isSignedIn() && (isGuest() || isActiveCustomer() || isAdmin()) &&
        data.keys().hasOnly([
          'schemaVersion', 'orderNumber', 'ownerUid', 'ownerType', 'contact', 'items',
          'subtotalSatang', 'shippingMethodId', 'shippingFeeSatang', 'totalSatang', 'currency',
          'status', 'payment', 'fulfillmentStatus', 'codAcceptance', 'shippingRevision', 'slipPath', 'submittedAt', 'review',
          'inventoryRestored', 'createdAt', 'updatedAt'
        ]) &&
        data.schemaVersion == 2 && data.ownerUid == request.auth.uid &&
        data.ownerType == (isGuest() ? 'guest' : 'customer') &&
        data.orderNumber is string && data.contact is map &&
        isSequentialNumber && (
          sequence.get('orderSequenceText', '') == data.orderNumber &&
          sequence.get('orderSequenceOrderId', '') == orderId &&
          sequence.get('orderSequence', 0) is int &&
          sequence.get('orderSequenceYear', 0) is int
        ) &&
        data.contact.keys().hasAll([
          'firstName', 'lastName', 'phone', 'email', 'addressLine1',
          'subdistrict', 'district', 'province', 'postalCode'
        ]) &&
        items is list && items.size() >= 1 && items.size() <= 5 &&
        validLineData(orderId, items, 0) && validLineData(orderId, items, 1) &&
        validLineData(orderId, items, 2) && validLineData(orderId, items, 3) &&
        validLineData(orderId, items, 4) &&
        data.subtotalSatang ==
          lineTotal(items, 0) + lineTotal(items, 1) + lineTotal(items, 2) +
          lineTotal(items, 3) + lineTotal(items, 4) &&
        data.shippingMethodId is string && validShipping(data, settings.get('shippingMethods', [])) &&
        data.totalSatang == data.subtotalSatang + data.shippingFeeSatang &&
        data.currency == 'THB' && data.status == 'pending_payment' &&
        data.payment.status == 'pending' &&
        data.fulfillmentStatus == (data.payment.method == 'cod' ? 'awaiting_cod_acceptance' : 'awaiting_payment') &&
        data.codAcceptance == null && data.shippingRevision == 0 &&
        validPayment(data, settings.get('paymentMethods', [])) &&
        data.slipPath == null && data.submittedAt == null &&
        data.review == null && data.inventoryRestored == false &&
        data.createdAt == request.time && data.updatedAt == request.time;
    }

    function canSubmitSlip(orderId) {
      return isSignedIn() && resource.data.ownerUid == request.auth.uid &&
        resource.data.schemaVersion == 2 &&
        resource.data.payment.method == 'manual_promptpay' &&
        resource.data.status == 'pending_payment' &&
        request.time < resource.data.createdAt + duration.value(24, 'h') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'slipPath', 'submittedAt', 'updatedAt'
        ]) &&
        request.resource.data.status == 'awaiting_review' &&
        request.resource.data.slipPath == 'orders/' + orderId + '/slip' &&
        request.resource.data.submittedAt == request.time &&
        request.resource.data.updatedAt == request.time;
    }

    function canReviewOrder() {
      return isAdmin() && resource.data.schemaVersion == 2 &&
        resource.data.status in ['pending_payment', 'awaiting_review'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'payment', 'review', 'inventoryRestored', 'fulfillmentStatus', 'updatedAt'
        ]) &&
        request.resource.data.review.by == request.auth.uid &&
        request.resource.data.review.at == request.time &&
        request.resource.data.updatedAt == request.time &&
        (
          ((resource.data.status == 'awaiting_review' && resource.data.payment.method == 'manual_promptpay' &&
            resource.data.slipPath != null &&
            request.resource.data.status == 'paid' &&
            request.resource.data.payment.status == 'successful' &&
            resource.data.fulfillmentStatus == 'awaiting_payment' &&
            request.resource.data.fulfillmentStatus == 'ready_to_prepare' &&
            request.resource.data.inventoryRestored == false &&
            request.resource.data.review.result == 'approved') ||
          (resource.data.status == 'pending_payment' && resource.data.payment.method == 'cod' &&
            resource.data.codAcceptance != null && resource.data.fulfillmentStatus == 'shipped' &&
            request.resource.data.status == 'paid' &&
            request.resource.data.payment.status == 'successful' &&
            request.resource.data.fulfillmentStatus == 'shipped' &&
            request.resource.data.inventoryRestored == false &&
            request.resource.data.review.result == 'approved')) ||
          (request.resource.data.status == 'cancelled' &&
            request.resource.data.payment.status == 'cancelled' &&
            request.resource.data.inventoryRestored == true &&
            request.resource.data.review.result == 'cancelled')
        );
    }

    function canAcceptCodOrder() {
      return isAdmin() && resource.data.schemaVersion == 2 &&
        resource.data.status == 'pending_payment' &&
        resource.data.payment.method == 'cod' && resource.data.payment.status == 'pending' &&
        resource.data.fulfillmentStatus == 'awaiting_cod_acceptance' &&
        resource.data.codAcceptance == null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'codAcceptance', 'fulfillmentStatus', 'updatedAt'
        ]) &&
        request.resource.data.codAcceptance.by == request.auth.uid &&
        request.resource.data.codAcceptance.at == request.time &&
        request.resource.data.fulfillmentStatus == 'ready_to_prepare' &&
        request.resource.data.updatedAt == request.time;
    }

    function canAdvanceFulfillment() {
      return isAdmin() && resource.data.schemaVersion == 2 &&
        resource.data.status in ['pending_payment', 'paid'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fulfillmentStatus', 'updatedAt']) &&
        request.resource.data.updatedAt == request.time &&
        (
          (resource.data.fulfillmentStatus == 'ready_to_prepare' &&
            request.resource.data.fulfillmentStatus == 'ready_to_ship' &&
            (resource.data.payment.method == 'cod'
              ? resource.data.codAcceptance != null
              : resource.data.status == 'paid' && resource.data.payment.status == 'successful')) ||
          (resource.data.fulfillmentStatus == 'ready_to_ship' &&
            request.resource.data.fulfillmentStatus == 'shipped' &&
            (resource.data.payment.method == 'cod'
              ? resource.data.codAcceptance != null
              : resource.data.status == 'paid' && resource.data.payment.status == 'successful'))
        );
    }

    function canCorrectOrderContact() {
      return isAdmin() && resource.data.schemaVersion == 2 &&
        resource.data.status in ['pending_payment', 'awaiting_review', 'paid'] &&
        resource.data.fulfillmentStatus != 'shipped' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'contact', 'shippingRevision', 'shippingContactUpdatedBy', 'shippingContactUpdatedAt', 'updatedAt'
        ]) &&
        request.resource.data.contact is map &&
        request.resource.data.contact.keys().hasOnly([
          'firstName', 'lastName', 'phone', 'email', 'addressLine1',
          'subdistrict', 'district', 'province', 'postalCode'
        ]) &&
        request.resource.data.contact.keys().hasAll([
          'firstName', 'lastName', 'phone', 'email', 'addressLine1',
          'subdistrict', 'district', 'province', 'postalCode'
        ]) &&
        request.resource.data.shippingRevision == resource.data.get('shippingRevision', 0) + 1 &&
        request.resource.data.shippingContactUpdatedBy == request.auth.uid &&
        request.resource.data.shippingContactUpdatedAt == request.time &&
        request.resource.data.updatedAt == request.time;
    }

    function canUpdateOrderTrackingNumber() {
      return isAdmin() && resource.data.schemaVersion == 2 &&
        resource.data.status in ['pending_payment', 'awaiting_review', 'paid'] &&
        resource.data.fulfillmentStatus in ['ready_to_prepare', 'ready_to_ship', 'shipped'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'trackingNumber', 'trackingUpdatedBy', 'trackingUpdatedAt', 'updatedAt'
        ]) &&
        request.resource.data.trackingNumber is string &&
        request.resource.data.trackingNumber.size() <= 80 &&
        request.resource.data.trackingNumber.trim() == request.resource.data.trackingNumber &&
        request.resource.data.trackingUpdatedBy == request.auth.uid &&
        request.resource.data.trackingUpdatedAt == request.time &&
        request.resource.data.updatedAt == request.time;
    }

    match /config/payment {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSuperAdmin() &&
        request.resource.data.keys().hasOnly(['phone', 'payeeName', 'enabled', 'updatedAt', 'updatedBy']) &&
        (request.resource.data.phone == '' || request.resource.data.phone.matches('^0[0-9]{9}$')) &&
        request.resource.data.enabled is bool &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.updatedAt == request.time;
      allow update: if (isSuperAdmin() &&
        request.resource.data.keys().hasOnly(['phone', 'payeeName', 'enabled', 'updatedAt', 'updatedBy']) &&
        (request.resource.data.phone == '' || request.resource.data.phone.matches('^0[0-9]{9}$')) &&
        request.resource.data.enabled is bool &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.updatedAt == request.time) || adminChangesPaymentAvailability();
      allow delete: if false;
    }

    match /settings/store {
      allow get: if isAdmin();
      allow list: if false;
      allow create: if (isSuperAdmin() &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.updatedAt == request.time) || adminCreatesOperationalSettings();
      allow update: if (isSuperAdmin() &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.updatedAt == request.time) || adminUpdatesOperationalSettings();
      allow delete: if false;
    }

    match /settings/public {
      allow get: if true;
      allow list: if false;
      allow create: if (isSuperAdmin() &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.updatedAt == request.time) || adminCreatesOperationalSettings();
      allow update: if (isSuperAdmin() &&
          request.resource.data.updatedBy == request.auth.uid &&
          request.resource.data.updatedAt == request.time) || adminUpdatesOperationalSettings() || advancesOrderSequence();
      allow delete: if false;
    }

    match /inventory/{productId}/options/{optionId} {
      function reservesForNewOrder() {
        let orderId = request.resource.data.lastOrderId;
        let orderPath = /databases/$(database)/documents/orders/$(orderId);
        let order = getAfter(orderPath).data;
        let index = request.resource.data.lastOrderLine;
        let line = order.items[index];
        return isSignedIn() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['available', 'lastOrderId', 'lastOrderLine']) &&
          orderId is string &&
          !exists(orderPath) &&
          resource.data.active == true &&
          index is int && index >= 0 && index < order.items.size() &&
          line.productId == productId && line.optionId == optionId &&
          line.quantity is int && line.quantity > 0 &&
          request.resource.data.available == resource.data.available - line.quantity &&
          request.resource.data.available >= 0;
      }
      allow get, list: if resource.data.active == true || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if reservesForNewOrder() || isAdmin();
    }

    // Buyers create an Order and reserve every option in one transaction.
    match /orders/{orderId} {
      allow get: if isAdmin() || (isSignedIn() && !exists(/databases/$(database)/documents/orders/$(orderId))) || (
        isSignedIn() && resource.data.ownerUid == request.auth.uid &&
        (isGuest() || isActiveCustomer())
      );
      allow list: if isAdmin() || (
        isSignedIn() && resource.data.ownerUid == request.auth.uid &&
        (isGuest() || isActiveCustomer())
      );
      allow create: if canCreateOrder(orderId);
      allow update: if canSubmitSlip(orderId) || canReviewOrder() || canAcceptCodOrder() ||
        canAdvanceFulfillment() || canCorrectOrderContact() || canUpdateOrderTrackingNumber();
      allow delete: if false;

      match /labelGenerations/{generationId} {
        allow get, list: if isAdmin();
        allow create: if isAdmin() &&
          request.resource.data.keys().hasOnly([
            'orderId', 'kind', 'createdBy', 'createdAt', 'shippingRevision', 'paymentMethod', 'totalSatang'
          ]) &&
          request.resource.data.orderId == orderId &&
          request.resource.data.kind in ['label', 'packing'] &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.shippingRevision == get(/databases/$(database)/documents/orders/$(orderId)).data.get('shippingRevision', 0) &&
          request.resource.data.paymentMethod == get(/databases/$(database)/documents/orders/$(orderId)).data.payment.method &&
          request.resource.data.totalSatang == get(/databases/$(database)/documents/orders/$(orderId)).data.totalSatang &&
          get(/databases/$(database)/documents/orders/$(orderId)).data.fulfillmentStatus in ['ready_to_prepare', 'ready_to_ship'] &&
          get(/databases/$(database)/documents/orders/$(orderId)).data.status != 'cancelled' &&
          (get(/databases/$(database)/documents/orders/$(orderId)).data.payment.method == 'cod'
            ? get(/databases/$(database)/documents/orders/$(orderId)).data.codAcceptance != null
            : get(/databases/$(database)/documents/orders/$(orderId)).data.status == 'paid' &&
              get(/databases/$(database)/documents/orders/$(orderId)).data.payment.status == 'successful') &&
          get(/databases/$(database)/documents/settings/store).data.get('storeName', '') is string &&
          get(/databases/$(database)/documents/settings/store).data.get('storeName', '').size() > 0 &&
          get(/databases/$(database)/documents/settings/store).data.get('storeAddress', '') is string &&
          get(/databases/$(database)/documents/settings/store).data.get('storeAddress', '').size() > 0 &&
          get(/databases/$(database)/documents/settings/store).data.get('contactPhone', '') is string &&
          get(/databases/$(database)/documents/settings/store).data.get('contactPhone', '').size() > 0;
        allow update, delete: if false;
      }
    }

    // Default fallback: deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
