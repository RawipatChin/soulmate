# Firebase Authentication & Web Configuration
# Obtained from Firebase Console > Project Settings > General > Your Apps > Web App
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_USE_FIREBASE_EMULATORS="false"
VITE_CHECKOUT_TEST_MODE_ENABLED="false"
VITE_OMISE_TEST_MODE_ENABLED="false"
VITE_KKU_INTELSPHERE_API_KEY=""

# Set CHECKOUT_MODE=test in functions/.env.<project-id> for the test Firebase project.
# Set server-side Omise secrets with Firebase Secret Manager:
# firebase functions:secrets:set OMISE_SECRET_KEY
# firebase functions:secrets:set OMISE_WEBHOOK_SECRET
